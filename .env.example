# ========================================================
# CampusConnect - Environment Configuration
# ========================================================

# Flask Settings
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
SECRET_KEY=change-this-to-a-very-secure-random-key-in-production
QR_SECRET_KEY=change-this-to-a-secure-qr-hmac-key

# Database Connection
# Option 1: Local SQLite (Default, no setup required)
# DATABASE_URL=sqlite:///instance/campusconnect.db

# Option 2: Azure SQL Database
# Replace <server>, <database>, <username>, <password> with your Azure SQL credentials:
# AZURE_SQL_DATABASE_URL=mssql+pyodbc:///?odbc_connect=Driver={ODBC Driver 18 for SQL Server};Server=tcp:<server>.database.windows.net,1433;Database=<database>;Uid=<username>;Pwd=<password>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Azure Blob Storage (Optional - falls back to local disk /uploads if empty)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER_NAME=event-media
AZURE_STORAGE_ACCOUNT_NAME=

# Power BI Integration (Optional)
POWER_BI_EMBED_URL=
POWER_BI_REPORT_ID=
